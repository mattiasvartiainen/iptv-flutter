{
  "name": "Flutter for webOS (Linux x64)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": [
      "--platform=linux/amd64"
    ]
  },
  "runArgs": [
    "--platform=linux/amd64"
  ],
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/iptv-flutter",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter-webos",
        "dart.sdkPath": "/opt/flutter-webos/bin/cache/dart-sdk"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
